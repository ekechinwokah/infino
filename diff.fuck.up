+/// Full-Parquet payload for [`build_one_shard_from_packed_cells`]: the shard's
+/// PRIMARY rows only, already in cell order (ascending cell id, primaries
+/// ascending `_id` within each cell), so the Parquet row order equals the
+/// concatenated primary order of the packed cell IVFs. `vectors` holds each
+/// vector column's fp32 values flattened in the same row order.
+struct PackedShardRows {
+    scalar: RecordBatch,
+    vectors: Vec<Vec<f32>>,
+}
+
+/// Gather the scalar rows at `(batch, row)` addresses from the buffered
+/// batches into one `RecordBatch`, in address order (arrow `interleave` —
+/// no intermediate concat copy).
+fn interleave_buffered_scalars(
+    buffer: &[BufferedBatch],
+    indices: &[(usize, usize)],
+) -> Result<RecordBatch, BuildError> {
+    let schema = buffer[0].scalar.schema();
+    let mut columns: Vec<ArrayRef> = Vec::with_capacity(schema.fields().len());
+    for c in 0..schema.fields().len() {
+        let arrays: Vec<&dyn Array> = buffer.iter().map(|b| b.scalar.column(c).as_ref()).collect();
+        columns.push(
+            interleave(&arrays, indices).map_err(|e| BuildError::Store(e.to_string()))?,
+        );
+    }
+    RecordBatch::try_new(schema, columns).map_err(|_| BuildError::BatchSchemaMismatch)
+}
+
+/// One `(batch, row)` address in the commit buffer plus the row's placement in
+/// a packed cell. Boundary stubs carry `is_primary = false`: they get an IVF
+/// posting (keyed by the primary's real `_id`) but no Parquet row.
+struct PackedCellMember {
+    stable_id: i128,
+    is_primary: bool,
+    batch: usize,
+    row: usize,
+}
+
+/// Cell-pack one commit buffer through the drain's building blocks: nearest
+/// cell + boundary-neighbor assignment ([`opann::boundary_assignment_fp32`]),
+/// per-cell fp32 subsection build ([`build_merged_subsection_from_fp32`]),
+/// packed-shard grouping ([`group_cells_by_packed_shard`]), and the shared
+/// packed-cell finish carrying the full Parquet rows. Runs inside the writer
+/// pool (`install` by the caller). Returns each shard's output plus its
+/// packed-shard partition hint.
+fn commit_buffer_packed_shards(
+    buffer: &[BufferedBatch],
+    options: &SupertableOptions,
+    grid: &ClusterCentroids,
+    metric: Metric,
+) -> Result<(Vec<ShardOutput>, Vec<Option<u32>>), BuildError> {
+    // Packed cell subsections are Sq8+ε by format invariant — the multi-cell
+    // read path derives the Sq8Residual row stride, and the drain/OPANN
+    // maintenance math operates on stored Sq8+ε bytes. The commit build
+    // therefore encodes cells as Sq8Residual regardless of the column's
+    // configured rerank codec (which still governs the legacy row-shard build).
+    let vc = options
+        .vector_columns
+        .first()
+        .cloned()
+        .ok_or_else(|| BuildError::Store("packed commit requires a vector column".into()))?
+        .with_rerank_codec(RerankCodec::Sq8Residual);
+    if vc.dim != grid.dim as usize || grid.n_cent == 0 {
+        return Err(BuildError::Store(format!(
+            "commit vector dim {} does not match global grid dim {}",
+            vc.dim, grid.dim
+        )));
+    }
+    let dim = vc.dim;
+
+    // Flat row addressing: (batch, row) + stable `_id` per buffered row, in
+    // append order.
+    let mut addrs: Vec<(usize, usize, i128)> = Vec::new();
+    for (bi, batch) in buffer.iter().enumerate() {
+        let ids = batch
+            .scalar
+            .column(0)
+            .as_any()
+            .downcast_ref::<Decimal128Array>()
+            .ok_or_else(|| {
+                BuildError::IdColumnWrongType(
+                    options.id_column.clone(),
+                    batch.scalar.schema().field(0).data_type().to_string(),
+                )
+            })?;
+        for r in 0..batch.scalar.num_rows() {
+            addrs.push((bi, r, ids.value(r)));
+        }
+    }
+    if addrs.is_empty() {
+        return Ok((Vec::new(), Vec::new()));
+    }
