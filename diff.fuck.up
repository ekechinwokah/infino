+                    stable_id,
+                    is_primary: false,
+                    batch,
+                    row,
+                });
+            }
+            for (i, assignment) in assignments.iter().enumerate() {
+                let (batch, row, stable_id) = addrs[i];
+                buckets
+                    .entry(assignment.primary)
+                    .or_default()
+                    .push(PackedCellMember {
+                        stable_id,
+                        is_primary: true,
+                        batch,
+                        row,
+                    });
+            }
+        }
+        // Unreachable with `assign_skip = false`; kept total for safety —
+        // plain nearest-cell assignment, no replicas.
+        None => {
+            let mut primary = vec![0u32; addrs.len()];
+            let mut off = 0usize;
+            for batch in buffer {
+                let n = batch.scalar.num_rows();
+                grid.assign_rows(metric, batch.vectors[0].values(), &mut primary[off..off + n]);
+                off += n;
+            }
+            for (i, &(batch, row, stable_id)) in addrs.iter().enumerate() {
+                buckets.entry(primary[i]).or_default().push(PackedCellMember {
+                    stable_id,
+                    is_primary: true,
+                    batch,
+                    row,
+                });
+            }
+        }
+    }
+    let cells: Vec<(u32, Vec<PackedCellMember>)> = buckets.into_iter().collect();
+
+    // Per-cell fp32 subsection build (primaries + stubs; inline stable-id
+    // region carries the real `_id` for every posting).
+    let built: Vec<(u32, (MergedIvfSubsection, Vec<i128>, Vec<PackedCellMember>))> = cells
+        .into_par_iter()
+        .map(|(cell, members)| {
+            let mut corpus = Vec::with_capacity(members.len() * dim);
+            let mut ids = Vec::with_capacity(members.len());
+            for m in &members {
+                let values = buffer[m.batch].vectors[0].values();
+                corpus.extend_from_slice(&values[m.row * dim..(m.row + 1) * dim]);
+                ids.push(m.stable_id);
+            }
+            let sub = build_merged_subsection_from_fp32(vc.clone(), Arc::new(corpus), &ids)?;
+            Ok((cell, (sub, ids, members)))
+        })
+        .collect::<Result<_, BuildError>>()?;
+
+    let packed = group_cells_by_packed_shard(built, packed_cell_shard_count(options));
+    let shard_outputs: Vec<(u32, ShardOutput)> = packed
+        .into_par_iter()
+        .map(|(shard_id, shard_cells)| {
+            // This shard's PRIMARY rows, in cell order.
+            let mut indices: Vec<(usize, usize)> = Vec::new();
+            for (_, (_, _, members)) in &shard_cells {
+                for m in members {
+                    if m.is_primary {
+                        indices.push((m.batch, m.row));
+                    }
+                }
+            }
+            let scalar = interleave_buffered_scalars(buffer, &indices)?;
+            let vectors: Vec<Vec<f32>> = options
+                .vector_columns
+                .iter()
+                .enumerate()
+                .map(|(ci, col)| {
+                    let d = col.dim;
+                    let mut out = Vec::with_capacity(indices.len() * d);
+                    for &(bi, row) in &indices {
+                        let values = buffer[bi].vectors[ci].values();
+                        out.extend_from_slice(&values[row * d..(row + 1) * d]);
+                    }
+                    out
+                })
+                .collect();
+            let triples: Vec<(u32, MergedIvfSubsection, Vec<i128>)> = shard_cells
+                .into_iter()
+                .map(|(cell, (sub, ids, _))| (cell, sub, ids))
+                .collect();
+            let out = build_one_shard_from_packed_cells(
+                triples,
+                options,
+                Some(PackedShardRows { scalar, vectors }),
+            )?;
+            Ok((shard_id, out))
+        })
+        .collect::<Result<_, BuildError>>()?;
+
+    let mut outputs = Vec::with_capacity(shard_outputs.len());
+    let mut hints = Vec::with_capacity(shard_outputs.len());
+    for (shard_id, out) in shard_outputs {
+        hints.push(Some(shard_id));
+        outputs.push(out);
+    }
+    Ok((outputs, hints))
+}
