+    // The DRAIN's assignment stage, called on the in-memory fp32 buffer —
+    // same replica budget, same data-parallel nearest-two pass, same
+    // accumulation order (budgeted boundary replicas first, then every
+    // primary in row order). fp32 rows carry no stored cluster, so the
+    // assign-skip fast path never applies here.
+    let row_refs: Vec<DrainRowRef<'_>> = addrs
+        .iter()
+        .map(|&(bi, row, _)| DrainRowRef::Fp32 {
+            vector: &buffer[bi].vectors[0].values()[row * dim..(row + 1) * dim],
+        })
+        .collect();
+    let mut buckets: BTreeMap<u32, Vec<PackedCellMember>> = BTreeMap::new();
+    match drain_boundary_assignments(&row_refs, grid, metric, &options.writer_pool, false) {
+        Some((assignments, replica_extra_budget)) => {
+            for (i, cell) in drain_replica_selection(&assignments, replica_extra_budget) {
