+/// One row entering the drain's assignment stage. The drain's own batches
+/// carry stored Sq8+ε rows materialized from committed superfiles; the commit
+/// path hands the SAME stage its in-memory fp32 buffer (the drain's
+/// commit-support extension, paired with the fp32 in-memory cell build).
+pub(in crate::supertable) enum DrainRowRef<'a> {
+    Encoded(&'a MaterializedIvfRow),
+    Fp32 { vector: &'a [f32] },
+}
+
+/// The drain's boundary-assignment stage, verbatim: compute the replica
+/// budget, and — unless the assign-skip fast path applies — run the
+/// data-parallel nearest-two assignment over every row on `pool`.
+///
+/// Returns `None` when the fast path applies (`replica budget == 0` and
+/// `assign_skip`): rows keep their stored cluster and no assignment runs —
+/// exactly the drain's `group(assign-skip)+accum` arm. Otherwise returns each
+/// row's [`opann::BoundaryAssignment`] plus the replica budget; the caller
+/// accumulates the budgeted closest-margin neighbor replicas first, then
+/// every primary, in row order — the drain's accumulation order.
+pub(in crate::supertable) fn drain_boundary_assignments(
+    rows: &[DrainRowRef<'_>],
+    clusters: &ClusterCentroids,
+    metric: Metric,
+    pool: &rayon::ThreadPool,
+    assign_skip: bool,
+) -> Option<(Vec<opann::BoundaryAssignment>, usize)> {
+    let replica_target = drain_replica_target_factor();
+    let replica_extra_budget = drain_replica_extra_budget(rows.len(), replica_target);
+    if replica_extra_budget == 0 && assign_skip {
+        return None;
+    }
+    let transposed_centroids = transpose_centroids_cluster_major(
+        &clusters.centroids,
+        clusters.n_cent as usize,
+        clusters.dim as usize,
+    );
+    let assignments: Vec<opann::BoundaryAssignment> = pool.install(|| {
+        rows.par_iter()
+            .map(|row| match row {
+                DrainRowRef::Encoded(row) => opann::boundary_assignment_encoded_with_transposed(
+                    clusters,
+                    &transposed_centroids,
+                    metric,
+                    &row.encoded,
+                ),
+                DrainRowRef::Fp32 { vector } => opann::boundary_assignment_fp32(
+                    clusters,
+                    Some(&transposed_centroids),
+                    metric,
+                    vector,
+                ),
+            })
+            .collect()
+    });
+    Some((assignments, replica_extra_budget))
+}
+
+/// The drain's replica selection, verbatim: every row's boundary neighbor is
+/// a candidate; keep the `budget` smallest margins. Returns
+/// `(row_idx, neighbor_cell)` in selection order.
+pub(in crate::supertable) fn drain_replica_selection(
+    assignments: &[opann::BoundaryAssignment],
+    budget: usize,
+) -> Vec<(usize, u32)> {
+    let mut replica_candidates: Vec<(usize, u32, f32)> = assignments
+        .iter()
+        .enumerate()
+        .filter_map(|(row_idx, assignment)| {
+            assignment
+                .neighbor
+                .map(|(neighbor, margin)| (row_idx, neighbor, margin))
+        })
+        .collect();
+    replica_candidates.sort_by(|a, b| a.2.total_cmp(&b.2));
+    replica_candidates
+        .into_iter()
+        .take(budget)
+        .map(|(row_idx, cell, _)| (row_idx, cell))
+        .collect()
+}
+
