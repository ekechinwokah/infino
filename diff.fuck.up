+    pub(crate) fn derived_cluster_cells(
+        &self,
+        entry: &SuperfileEntry,
+        column: &str,
+        grid: &ClusterCentroids,
+        metric: Metric,
+    ) -> Option<Arc<Vec<u32>>> {
+        if let Some(hit) = self.inner.cluster_cells_cache.get(&entry.superfile_id) {
+            return Some(Arc::clone(&hit));
+        }
+        let vs = entry.vector_summary.get(column)?;
+        if vs.clusters.is_empty() || vs.clusters.dim != grid.dim {
+            return None;
+        }
+        let mut cells = vec![0u32; vs.clusters.n_cent as usize];
+        grid.assign_rows(metric, &vs.clusters.centroids, &mut cells);
+        let cells = Arc::new(cells);
+        self.inner
+            .cluster_cells_cache
+            .insert(entry.superfile_id, Arc::clone(&cells));
+        Some(cells)
+    }
+
