+/// Vector-led split for packed commit layout:
+/// 1) assign each row to its nearest global cell,
+/// 2) map cell -> shard via `cell % n_shards`,
+/// 3) keep row order within each shard in original append order.
+fn split_buffer_by_vector_cell_shard(
+    buffer: Vec<BufferedBatch>,
+    cells: &ClusterCentroids,
+    metric: Metric,
+    vec_col_idx: usize,
+    n_shards: usize,
+) -> (Vec<Vec<BufferedBatch>>, Vec<Option<u32>>) {
+    let shard_batches = split_buffer_by_cell_bucket(
+        buffer,
+        cells,
+        metric,
+        vec_col_idx,
+        n_shards,
+        |cell| packed_cell_shard(cell, n_shards),
+    );
+
+    let mut shards = Vec::new();
+    let mut hints = Vec::new();
+    for (shard_id, batches) in shard_batches.into_iter().enumerate() {
+        if batches.is_empty() {
+            continue;
+        }
+        shards.push(batches);
+        hints.push(Some(shard_id as u32));
+    }
+    (shards, hints)
+}
+
+/// Drain/commit packed-layout target shard count: keep cell-packed output at a
+/// small, fixed fanout tied to host CPU width.
+const PACKED_CELL_SHARDS_SMALL: usize = 8;
+/// Upper packed-layout shard count on larger hosts.
+const PACKED_CELL_SHARDS_LARGE: usize = 16;
+/// Tolerance for checking whether a user superfile's centroids are exactly the
+/// global grid copied at build time.
+const GLOBAL_ALIGNMENT_CENTROID_EPSILON: f32 = 1e-6;
+
+/// Packed shard count used by drain publish and vector-led commit output.
+fn packed_cell_shard_count() -> usize {
+    if num_cpus::get() >= PACKED_CELL_SHARDS_LARGE {
+        PACKED_CELL_SHARDS_LARGE
+    } else {
+        PACKED_CELL_SHARDS_SMALL
+    }
+}
+
+/// Shared cell -> packed-shard mapping for commit and drain.
+fn packed_cell_shard(cell: u32, shard_count: usize) -> usize {
+    debug_assert!(shard_count > 0);
+    (cell as usize) % shard_count
+}
+
+/// Returns `true` when this user superfile's vector-summary centroids are the
+/// global grid for `column` (the aligned-build invariant: cluster `c == cell c`).
+fn superfile_uses_global_grid(
+    entry: &SuperfileEntry,
+    column: &str,
+    grid: &ClusterCentroids,
+) -> bool {
+    let Some(summary) = entry.vector_summary.get(column) else {
+        return false;
+    };
+    if summary.clusters.n_cent != grid.n_cent || summary.clusters.dim != grid.dim {
+        return false;
+    }
+    summary
+        .clusters
+        .centroids
+        .iter()
+        .zip(grid.centroids.iter())
+        .all(|(a, b)| (a - b).abs() <= GLOBAL_ALIGNMENT_CENTROID_EPSILON)
+}
+
+/// Group `(cell, rows)` payloads into packed shard buckets (`cell % shard_count`).
+fn group_rows_by_packed_shard<T>(
+    rows_by_cell: Vec<(u32, Vec<T>)>,
+    shard_count: usize,
+) -> Vec<Vec<T>> {
+    debug_assert!(shard_count > 0);
+    let mut rows_by_shard: Vec<Vec<T>> = (0..shard_count).map(|_| Vec::new()).collect();
+    for (cell, mut rows) in rows_by_cell {
+        if rows.is_empty() {
+            continue;
+        }
+        let shard = packed_cell_shard(cell, shard_count);
+        rows_by_shard[shard].append(&mut rows);
+    }
+    rows_by_shard
+}
