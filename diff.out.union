+/// Unified shard-build input for commit/drain vector paths.
+enum PackedShardBuildInput<'a> {
+    Buffered {
+        slice: &'a [BufferedBatch],
+        vector_layout: VectorLayout,
+        provided_centroids: Option<Arc<[f32]>>,
+    },
+    Materialized {
+        rows: &'a [MaterializedIvfRow],
+        vector_layout: VectorLayout,
+    },
+    Merged {
+        merged: MergedIvfSubsection,
+        stable_ids: &'a [i128],
+    },
+}
+
+/// Shared shard builder adapter used by commit/drain paths.
+fn build_packed_shard_output(
+    options: &SupertableOptions,
+    input: PackedShardBuildInput<'_>,
+) -> Result<ShardOutput, BuildError> {
+    match input {
+        PackedShardBuildInput::Buffered {
+            slice,
+            vector_layout,
+            provided_centroids,
+        } => build_one_shard_with_layout(
+            slice,
+            options,
+            vector_layout,
+            provided_centroids,
+        ),
+        PackedShardBuildInput::Materialized {
+            rows,
+            vector_layout,
+        } => build_one_shard_from_materialized(rows, options, vector_layout),
+        PackedShardBuildInput::Merged { merged, stable_ids } => {
+            build_one_shard_from_merged(merged, stable_ids, options)
+        }
+    }
+}
