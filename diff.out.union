+/// Drain/packed publish variant: when possible, pack prepared superfiles
+/// into `8|16` shard containers (`partition_hint % shard_count`) and stamp
+/// each entry's `subsection_offsets.base_offset` to its slice start.
+///
+/// The in-memory reader tier cannot slice a container (it opens whole bytes,
+/// which for a concatenation parses only the trailing superfile), so any
+/// group that must feed that tier (`bytes_for_store` present — no disk cache
+/// attached) publishes unpacked.
+fn collect_prepared_superfiles_for_drain_publish(
+    inner: &SupertableInner,
+    mut prepared: Vec<PreparedSuperfile>,
+) -> Result<SuperfilePublishBatch, BuildError> {
+    if prepared.is_empty() || inner.options.storage.is_none() {
+        return collect_prepared_superfiles(inner, prepared);
+    }
+    if prepared.iter().any(|p| p.bytes_for_storage.is_none()) {
+        // Need one storage payload per prepared entry to build packed containers.
+        return collect_prepared_superfiles(inner, prepared);
+    }
+
+    prepared.sort_unstable_by_key(|p| {
+        (
+            p.entry.partition_hint.unwrap_or(u32::MAX),
+            p.entry.superfile_id,
+        )
+    });
+
+    let shard_count = packed_cell_shard_count().max(1);
+    let mut per_shard: Vec<Vec<PreparedSuperfile>> = (0..shard_count).map(|_| Vec::new()).collect();
+    for p in prepared {
+        let shard_idx = p
+            .entry
+            .partition_hint
+            .map(|h| packed_cell_shard(h, shard_count))
+            .unwrap_or(0);
+        per_shard[shard_idx].push(p);
+    }
+
+    let mut new_entries: Vec<Arc<SuperfileEntry>> = Vec::new();
+    let mut pending_storage_writes: Vec<(SuperfileUri, Bytes)> = Vec::new();
+    let mut pending_cache_inserts: Vec<(SuperfileUri, Bytes)> = Vec::new();
+
+    for shard in per_shard {
+        if shard.is_empty() {
+            continue;
+        }
+        let shard_needs_store = shard.iter().any(|p| p.bytes_for_store.is_some());
+        if shard_needs_store {
+            for p in shard {
+                if let Some((uri, b)) = p.bytes_for_store {
+                    inner
+                        .options
+                        .store
+                        .insert(uri, b)
+                        .map_err(|e| BuildError::Store(e.to_string()))?;
+                }
+                if let Some(t) = p.bytes_for_storage {
+                    pending_storage_writes.push(t);
+                }
+                if let Some(t) = p.bytes_for_cache {
+                    pending_cache_inserts.push(t);
+                }
+                new_entries.push(p.entry);
+            }
+            continue;
+        }
+        let container_uri = SuperfileUri::new_v4();
+        let container_len: usize = shard
+            .iter()
+            .map(|p| {
+                p.bytes_for_storage
+                    .as_ref()
+                    .map(|(_, b)| b.len())
+                    .unwrap_or(0)
+            })
+            .sum();
+        let mut container = BytesMut::with_capacity(container_len);
+        let mut cursor = 0u64;
+        for p in shard {
+            let Some((_, bytes)) = p.bytes_for_storage else {
+                return Err(BuildError::Store(
+                    "packed drain publish missing storage bytes".into(),
+                ));
+            };
+            let mut staged = p.entry.as_ref().clone();
+            let mut subsection_offsets = staged.subsection_offsets.clone().ok_or_else(|| {
+                BuildError::Store("packed drain publish requires subsection offsets".into())
+            })?;
+            subsection_offsets.base_offset = cursor;
+            staged.uri = container_uri;
+            staged.subsection_offsets = Some(subsection_offsets);
+            new_entries.push(Arc::new(staged));
+            cursor = cursor.saturating_add(bytes.len() as u64);
+            container.extend_from_slice(bytes.as_ref());
+        }
+        pending_storage_writes.push((container_uri, container.freeze()));
+    }
+
+    Ok(SuperfilePublishBatch {
+        new_entries,
+        to_remove: Vec::new(),
+        pending_storage_writes,
+        // Packed container bytes are not a valid standalone superfile payload;
+        // only unpacked groups (the in-memory-store fallback) contribute warm
+        // cache inserts.
+        pending_cache_inserts,
+    })
+}
