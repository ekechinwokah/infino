+    /// Coarse cell gate: score the global cell grid and keep the closest
+    /// `nprobe` cells. Returns `None` when there is no usable global grid for
+    /// this column/query shape (then the caller ranks all resident centroids).
+    fn select_probe_cells(
+        &self,
+        column: &str,
+        query: &[f32],
+        metric: Metric,
+        nprobe: usize,
+    ) -> Option<Vec<u32>> {
+        if nprobe == 0 {
+            return Some(Vec::new());
+        }
+        let gvi = self.manifest().get_global_vector_index()?;
+        if gvi.column != column || gvi.grid.n_cent == 0 || gvi.grid.dim as usize != query.len() {
+            return None;
+        }
+        let mut scored_cells: Vec<(u32, f32)> = (0..gvi.grid.n_cent)
+            .map(|cell| (cell, gvi.grid.score_one(metric, cell as usize, query)))
+            .collect();
+        if scored_cells.len() > nprobe {
+            scored_cells.select_nth_unstable_by(nprobe, |a, b| {
+                a.1.partial_cmp(&b.1)
+                    .unwrap_or(Ordering::Equal)
+                    .then_with(|| a.0.cmp(&b.0))
+            });
+            scored_cells.truncate(nprobe);
+        }
+        Some(scored_cells.into_iter().map(|(cell, _)| cell).collect())
+    }
