+    fn assign_pack_boundary_replicas_are_vector_only_stubs() {
+        let dim = COMMIT_AS_DRAIN_TEST_DIM;
+        let mut centroids = vec![0.0f32; dim * 2];
+        centroids[dim] = 1.0;
+        let clusters = ClusterCentroids::from_fp32(2, dim as u32, &centroids, vec![0, 0]);
+        let vectors = [
+            vec![0.49; dim],
+            vec![0.51; dim],
+            vec![0.48; dim],
+            vec![0.52; dim],
+        ];
+        let stable_ids = [10_i128, 11, 12, 13];
+        let rows: Vec<PackRow<'_>> = vectors
+            .iter()
+            .zip(stable_ids)
+            .map(|(vector, stable_id)| PackRow::Fp32 { stable_id, vector })
+            .collect();
+        let cfg = VectorConfig {
+            column: "emb".into(),
+            dim,
+            n_cent: 2,
+            rot_seed: 7,
+            metric: Metric::L2Sq,
+            rerank_codec: RerankCodec::Fp32,
+            provided_centroids: Some(Arc::from(centroids)),
+        };
+        let groups = assign_and_pack_cells(
+            &rows,
+            &clusters,
+            Metric::L2Sq,
+            false,
+            BOUNDARY_STUB_TARGET_FACTOR,
+            cfg,
+        )
+        .expect("assign and pack");
+
+        let postings: usize = groups.iter().map(|group| group.stable_ids.len()).sum();
+        let primaries: usize = groups
+            .iter()
+            .flat_map(|group| group.is_primary.iter())
+            .filter(|&&is_primary| is_primary)
+            .count();
+        assert_eq!(primaries, rows.len());
+        assert!(
+            postings > primaries,
+            "boundary replicas add vector postings, not primary rows"
+        );
+        for group in &groups {
+            assert_eq!(group.stable_ids.len(), group.subsection.n_docs as usize);
+            assert_eq!(group.is_primary.len(), group.stable_ids.len());
+        }
+    }
