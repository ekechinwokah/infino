+fn build_one_user_shard_from_packed_cells(
+    cells: Vec<PackedCellGroup>,
+    source_scalar: &RecordBatch,
+    source_vectors: &[Vec<f32>],
+    primary_local_by_id: &HashMap<i128, usize>,
+    options: &SupertableOptions,
+) -> Result<ShardOutput, BuildError> {
+    if cells.is_empty() {
+        return Err(BuildError::NoDocsToBuild);
+    }
+
+    let mut primary_ids = Vec::new();
+    let mut source_indices = Vec::new();
+    let mut subsections = Vec::with_capacity(cells.len());
+    for cell in cells {
+        if cell.stable_ids.len() != cell.subsection.n_docs as usize {
+            return Err(BuildError::Store(format!(
+                "cell {}: stable_ids len {} != subsection n_docs {}",
+                cell.cell_id,
+                cell.stable_ids.len(),
+                cell.subsection.n_docs
+            )));
+        }
+        if cell.is_primary.len() != cell.stable_ids.len() {
+            return Err(BuildError::Store(format!(
+                "cell {}: primary marker len {} != stable_ids len {}",
+                cell.cell_id,
+                cell.is_primary.len(),
+                cell.stable_ids.len()
+            )));
+        }
+        for (&stable_id, &is_primary) in cell.stable_ids.iter().zip(&cell.is_primary) {
+            if is_primary {
+                let Some(&source_local) = primary_local_by_id.get(&stable_id) else {
+                    return Err(BuildError::Store(format!(
+                        "primary stable_id {stable_id} missing from commit source rows"
+                    )));
+                };
+                primary_ids.push(stable_id);
+                source_indices.push(source_local as u32);
+            }
+        }
+        subsections.push((cell.cell_id, cell.subsection));
+    }
+    if primary_ids.is_empty() {
+        return Err(BuildError::NoDocsToBuild);
+    }
+
+    let take_indices = UInt32Array::from(source_indices);
+    let columns: Vec<ArrayRef> = source_scalar
+        .columns()
+        .iter()
+        .map(|column| take(column.as_ref(), &take_indices, None))
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(|err| BuildError::Store(err.to_string()))?;
+    let scalar = RecordBatch::try_new(source_scalar.schema(), columns)
+        .map_err(|_| BuildError::BatchSchemaMismatch)?;
+
+    let mut ordered_vectors = Vec::with_capacity(source_vectors.len());
+    for (col_idx, source) in source_vectors.iter().enumerate() {
+        let dim = options.vector_columns[col_idx].dim;
+        let mut ordered = Vec::with_capacity(primary_ids.len() * dim);
+        for &source_local in take_indices.values() {
+            let start = source_local as usize * dim;
+            let end = start + dim;
+            let Some(slice) = source.get(start..end) else {
+                return Err(BuildError::Store(format!(
+                    "source vector local {source_local} out of bounds for column {col_idx}"
+                )));
+            };
+            ordered.extend_from_slice(slice);
+        }
+        ordered_vectors.push(ordered);
+    }
+    let vector_slices: Vec<&[f32]> = ordered_vectors.iter().map(Vec::as_slice).collect();
+
+    let mut builder = SuperfileBuilder::new(
+        options
+            .builder_options()
+            .with_vector_layout(VectorLayout::MultiCellIvf),
+    )?;
+    builder.add_batch(&scalar, &vector_slices)?;
+    builder.set_prebuilt_multi_cell_ivfs(subsections)?;
+
+    let id_min = primary_ids.iter().copied().min().unwrap_or(0);
+    let id_max = primary_ids.iter().copied().max().unwrap_or(0);
+    let n_docs = primary_ids.len() as u64;
+    let scalar_stats = ScalarStatsAgg::from_batches(&options.scalar_schema(), &[&scalar]);
+    let bytes = Bytes::from(builder.finish()?);
+
+    Ok(ShardOutput {
+        bytes,
+        n_docs,
+        id_min,
+        id_max,
+        scalar_stats,
+    })
+}
+
+fn commit_buffer_via_assign_pack(
+    buffer: Vec<BufferedBatch>,
+    inner: &SupertableInner,
+    clusters: &ClusterCentroids,
+    metric: Metric,
+) -> Result<(Vec<ShardOutput>, Vec<Option<u32>>), BuildError> {
+    let vc = inner
+        .options
+        .vector_columns
+        .first()
+        .cloned()
+        .ok_or_else(|| BuildError::Store("assign-pack commit requires a vector column".into()))?;
+    if vc.dim != clusters.dim as usize {
+        return Err(BuildError::Store(format!(
+            "commit vector dim {} does not match global grid dim {}",
+            vc.dim, clusters.dim
+        )));
+    }
+
+    let scalar_batches: Vec<RecordBatch> = buffer
+        .iter()
+        .filter(|batch| batch.scalar.num_rows() > 0)
+        .map(|batch| batch.scalar.clone())
+        .collect();
+    if scalar_batches.is_empty() {
+        return Ok((Vec::new(), Vec::new()));
+    }
+    let source_scalar = concat_batches(&inner.options.scalar_schema(), &scalar_batches)
+        .map_err(|err| BuildError::Store(err.to_string()))?;
+    let total_rows = source_scalar.num_rows();
+
+    let id_col = source_scalar
+        .column(0)
+        .as_any()
+        .downcast_ref::<Decimal128Array>()
+        .ok_or_else(|| {
+            BuildError::IdColumnWrongType(
+                inner.options.id_column.clone(),
+                "<id column not Decimal128 at runtime>".to_string(),
+            )
+        })?;
+    let stable_ids: Vec<i128> = (0..id_col.len()).map(|row| id_col.value(row)).collect();
+    let primary_local_by_id: HashMap<i128, usize> = stable_ids
+        .iter()
+        .enumerate()
+        .map(|(local, &stable_id)| (stable_id, local))
+        .collect();
+
+    let mut source_vectors = vec![Vec::new(); inner.options.vector_columns.len()];
+    for batch in &buffer {
+        for (col_idx, vectors) in batch.vectors.iter().enumerate() {
+            source_vectors[col_idx].extend_from_slice(vectors.values());
+        }
+    }
+    let primary_source = source_vectors.first().ok_or_else(|| {
+        BuildError::Store("assign-pack commit missing primary vector column".into())
+    })?;
+    if primary_source.len() != total_rows * vc.dim {
+        return Err(BuildError::Store(format!(
+            "primary vector values len {} != rows {} * dim {}",
+            primary_source.len(),
+            total_rows,
+            vc.dim
+        )));
+    }
+
+    let rows: Vec<PackRow<'_>> = stable_ids
+        .iter()
+        .enumerate()
+        .map(|(local, &stable_id)| {
+            let start = local * vc.dim;
+            let end = start + vc.dim;
+            PackRow::Fp32 {
+                stable_id,
+                vector: &primary_source[start..end],
+            }
+        })
+        .collect();
+    let vector_cfg = vc.clone().with_rerank_codec(RerankCodec::Sq8Residual);
+    let packed_groups = assign_and_pack_cells(
+        &rows,
+        clusters,
+        metric,
+        false,
+        drain_replica_target_factor(),
+        vector_cfg,
+    )?;
+    let packed_cells = packed_groups
+        .into_iter()
+        .map(|group| (group.cell_id, group))
+        .collect();
+    let packed_shards =
+        group_cells_by_packed_shard(packed_cells, packed_cell_shard_count(&inner.options));
+
+    let outputs = inner.options.writer_pool.install(|| {
+        packed_shards
+            .into_par_iter()
+            .map(|(shard_id, cells)| {
+                let groups: Vec<PackedCellGroup> =
+                    cells.into_iter().map(|(_, group)| group).collect();
+                build_one_user_shard_from_packed_cells(
+                    groups,
+                    &source_scalar,
+                    &source_vectors,
+                    &primary_local_by_id,
+                    &inner.options,
+                )
+                .map(|output| (shard_id, output))
+            })
+            .collect::<Result<Vec<_>, BuildError>>()
+    })?;
+    let mut outputs_sorted = outputs;
+    outputs_sorted.sort_unstable_by_key(|(shard_id, _)| *shard_id);
+    let cell_hints: Vec<Option<u32>> = outputs_sorted
+        .iter()
+        .map(|(shard_id, _)| Some(*shard_id))
+        .collect();
+    let shard_outputs = outputs_sorted
+        .into_iter()
+        .map(|(_, output)| output)
+        .collect();
+    Ok((shard_outputs, cell_hints))
+}
+
