+/// Minimum wall time a warm-CPU amortization loop runs before it stops, so
+/// the two boundary CPU reads amortize to ~0 even for hundreds-of-ns ops.
+/// 100 ms is still ~330k iterations at ~300 ns/op — the CPU delta is resolved
+/// to well under a percent — while keeping the per-query measurement overhead
+/// modest.
+pub const WARM_CPU_MIN_WALL: Duration = Duration::from_millis(100);
+/// Hard iteration cap for the warm-CPU loop, so a slower-than-expected op
+/// can't spin unbounded (at ~300ns/op, 200ms is ~700k iters — the cap is
+/// generous headroom above that).
+pub const WARM_CPU_MAX_ITERS: usize = 20_000_000;
+
+/// Mean of a CPU-seconds sample set, or `None` when nothing was sampled
+/// (CPU accounting unavailable on the platform).
+fn mean_cpu_s(samples: &[f64]) -> Option<f64> {
+    if samples.is_empty() {
+        None
+    } else {
+        Some(samples.iter().sum::<f64>() / samples.len() as f64)
+    }
+}
+
