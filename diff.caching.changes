+/// Working-set cap for one wave of the drain's end-of-run per-cell builds:
+/// cells are grouped until their spilled row bytes reach this budget, then the
+/// group is built in parallel, uploaded, and freed before the next wave. Keeps
+/// end-build RAM bounded by the cap (plus one build in flight) instead of the
+/// whole hidden index, without letting the batch knob leak into the layout.
+const DRAIN_BUILD_GROUP_BYTES: u64 = 4 * (1 << 30);
+
+/// Append one materialized row to `cell`'s spill, creating the cell's writer
+/// on first touch (row shape — dim + RaBitQ length — is taken from that first
+/// row). Borrows the row; nothing is cloned. `added` tracks per-cell row
+/// counts for the end-of-drain grid update.
+fn spill_row_to_cell(
+    spills: &mut HashMap<u32, MaterializedRowSpillWriter>,
+    added: &mut HashMap<u32, u32>,
+    scratch: &Path,
+    cell: u32,
+    row: &MaterializedIvfRow,
+) -> Result<(), BuildError> {
+    let writer = match spills.entry(cell) {
+        Entry::Occupied(o) => o.into_mut(),
+        Entry::Vacant(v) => v.insert(MaterializedRowSpillWriter::create(
+            scratch,
+            cell,
+            row.encoded.codes.len(),
+            row.rabitq_code.len(),
+        )?),
+    };
+    writer.append(row)?;
+    let n = added.entry(cell).or_insert(0);
+    *n = n.saturating_add(1);
+    Ok(())
+}
