+    /// gated phase diagnostics to price a compute wave in CPU, not wall.
+    /// `None` on platforms without that procfs surface.
+    pub fn process_cpu_ns() -> Option<u128> {
+        #[cfg(target_os = "linux")]
+        {
+            let mut total: u128 = 0;
+            let mut any = false;
+            for entry in std::fs::read_dir("/proc/self/task").ok()? {
+                let Ok(entry) = entry else { continue };
+                let Ok(raw) = std::fs::read_to_string(entry.path().join("schedstat")) else {
+                    continue;
+                };
+                if let Some(ns) = raw
+                    .split_whitespace()
+                    .next()
+                    .and_then(|f| f.parse::<u128>().ok())
+                {
+                    total += ns;
+                    any = true;
+                }
+            }
+            any.then_some(total)
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            None
+        }
+    }
+
     /// Per-fetch *timeline* — diagnostic for the cold-search critical path.
