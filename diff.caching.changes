+/// Non-negative fg+bg process CPU seconds between two
+/// [`crate::storage::io_counters::process_cpu_ns`] snapshots (`0.0` when CPU
+/// sampling is unavailable). Powers the drain's per-phase CPU-vs-wall log line
+/// — wall ≫ CPU means a phase is I/O-bound, wall ≈ CPU means CPU-bound.
+fn drain_cpu_s(start: Option<u128>, end: Option<u128>) -> f64 {
+    match (start, end) {
+        (Some(a), Some(b)) => b.saturating_sub(a) as f64 / 1e9,
+        _ => 0.0,
+    }
+}
