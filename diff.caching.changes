+    /// The drain batch budget is a MEMORY bound (how many user superfiles are
+    /// materialized at once) — it must never change the published layout. One
+    /// drain run over N undrained commits produces exactly ONE superfile per
+    /// touched cell, whether the budget forces N batches (budget 1, as here)
+    /// or a single batch. Regression for the fragmentation where each batch
+    /// published its own file per cell (files/cell == batch count).
+    #[test]
+    fn drain_batch_budget_never_changes_cell_layout() {
+        use std::{collections::HashMap, sync::Arc};
+
+        use arrow_array::{Array, FixedSizeListArray, Float32Array, LargeStringArray};
+        use arrow_schema::{DataType, Field, Schema};
+
+        use crate::superfile::{
+            builder::{FtsConfig, VectorConfig},
+            vector::{distance::Metric, rerank_codec::RerankCodec},
+        };
+
+        let dim = 16usize;
+        let item_field = Arc::new(Field::new("item", DataType::Float32, true));
+        let schema = Arc::new(Schema::new(vec![
+            Field::new("title", DataType::LargeUtf8, false),
+            Field::new(
+                "emb",
+                DataType::FixedSizeList(item_field.clone(), dim as i32),
+                false,
+            ),
+        ]));
+        let pool = Arc::new(
+            rayon::ThreadPoolBuilder::new()
+                .num_threads(1)
+                .build()
+                .expect("pool"),
+        );
+        let dir = TempDir::new().expect("tempdir");
+        let storage: Arc<dyn StorageProvider> =
+            Arc::new(LocalFsStorageProvider::new(dir.path()).expect("provider"));
+        let mut options = SupertableOptions::new(
+            schema.clone(),
+            vec![FtsConfig {
+                column: "title".into(),
+            }],
+            vec![VectorConfig {
+                column: "emb".into(),
+                dim,
+                n_cent: 4,
+                rot_seed: 7,
+                metric: Metric::Cosine,
+                rerank_codec: RerankCodec::Sq8Residual,
+                provided_centroids: None,
+            }],
+            Some(crate::test_helpers::default_tokenizer()),
+        )
+        .expect("valid options")
+        .with_storage(storage)
+        .with_writer_pool(pool);
+        // The smallest budget = the worst historical fragmentation: one batch
+        // per commit. The layout must come out identical to a single batch.
+        options.drain_batch_superfiles = 1;
+        let st = Supertable::create(options).expect("create");
+
+        const N_COMMITS: usize = 3;
+        for commit in 0..N_COMMITS {
+            let titles = LargeStringArray::from(vec![format!("doc-{commit}")]);
+            let flat = Float32Array::from(vec![1.0f32; dim]);
+            let fsl = FixedSizeListArray::new(item_field.clone(), dim as i32, Arc::new(flat), None);
+            let batch = arrow_array::RecordBatch::try_new(
+                schema.clone(),
+                vec![
+                    Arc::new(titles) as Arc<dyn Array>,
+                    Arc::new(fsl) as Arc<dyn Array>,
+                ],
+            )
+            .expect("batch");
+            let mut w = st.writer().expect("writer");
+            w.append(&batch).expect("append");
+            w.commit().expect("commit");
+        }
+
+        st.drain_vectors_to_cells_sync().expect("drain");
+
+        let hidden = st
+            .reader()
+            .vector_index_table()
+            .expect("hidden index")
+            .clone();
+        let reader = hidden.reader();
+        let manifest = reader.manifest();
+        let mut per_cell = HashMap::<Vec<u8>, usize>::new();
+        let mut total_rows = 0u64;
+        for e in manifest.superfiles.iter() {
+            *per_cell.entry(e.partition_key.clone()).or_default() += 1;
+            total_rows += e.n_docs;
+        }
+        let max_per_cell = per_cell.values().copied().max().unwrap_or(0);
+        assert_eq!(
+            max_per_cell, 1,
+            "one drain run must publish exactly one superfile per cell, \
+             independent of the batch budget (got {max_per_cell} for some cell)"
+        );
+        assert_eq!(
+            total_rows, N_COMMITS as u64,
+            "every drained row lands exactly once (no batch duplication)"
+        );
+        assert!(
+            !manifest.get_drained_ranges().is_empty(),
+            "the single publish must advance the drained watermark"
+        );
+
+        // Re-drain with nothing new: a no-op (watermark covers all commits).
+        st.drain_vectors_to_cells_sync().expect("re-drain no-op");
+        let hidden = st
+            .reader()
+            .vector_index_table()
+            .expect("hidden index")
+            .clone();
+        let n_after = hidden.reader().manifest().superfiles.iter().count();
+        assert_eq!(
+            n_after,
+            per_cell.len(),
+            "no-op re-drain must not append cell files"
+        );
+    }
+
